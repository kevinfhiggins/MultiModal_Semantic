# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mod_semantic_search
MONGODB_COLLECTION=MoD_Data

# Voyage AI Configuration
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-3

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Vector Search Configuration
VECTOR_INDEX_NAME=vector_index
VECTOR_DIMENSION=1024

# File Storage Configuration
# Local directory the backend serves media files from.
FILE_STORAGE_PATH=sample_data
FILE_BASE_URL=http://localhost:8000/files

# S3-backed media assets (optional)
# When S3_BUCKET is set, files missing from FILE_STORAGE_PATH are fetched from
# S3 on demand and cached under FILE_CACHE_PATH (defaults to FILE_STORAGE_PATH).
# Requires AWS credentials in the environment (aws configure / env vars / role).
S3_BUCKET=mod-semantic-demo
S3_PREFIX=sample_data
FILE_CACHE_PATH=sample_data
AWS_REGION=us-east-2
